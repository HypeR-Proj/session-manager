{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "session-manager",
  "kind": "service",
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-session-manager"
    ]
  ],
  "cargo": [
    {
      "manifest": "Cargo.toml",
      "domain": "system"
    }
  ],
  "artifacts": [
    {
      "binary": "hyper-session-manager",
      "staged": "session-manager",
      "destination": "svc/session-manager",
      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "Cargo.toml",
      "enabled": true,
      "requires": [
        {
          "module": "terminal-service",
          "artifact": "terminal-service"
        },
        {
          "module": "shell",
          "artifact": "sh"
        },
        {
          "module": "component-manager",
          "artifact": "component-manager"
        },
        {
          "module": "journald",
          "artifact": "svc/journal"
        }
      ]
    }
  ],
  "build": {
    "type": "native-rust",
    "requires": [
      "toolchain"
    ]
  }
}
